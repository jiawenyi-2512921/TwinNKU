# Server-only configuration. Copy to .env, chmod 600; never commit .env.
APP_ENV=production
APP_VERSION=0.4.0
DB_NAME=twinnku
DB_USER=twinnku
DB_PASSWORD=change-me-to-a-random-48-character-hex-value
DB_APP_USER=twinnku_app
DB_APP_PASSWORD=change-me-to-a-distinct-random-48-character-hex-value
ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
HTTP_PORT=8080
MAP_ENABLED=true
FLOORS_ENABLED=true
VR_ENABLED=true
# Add the actual public hostname to ALLOWED_HOSTS before exposing through HTTPS.
# Keep public paid calls disabled until the security and supplier checks pass.
# Native API credentials stay on the server; third-party WebSDK fallback is removed.
PUBLIC_SITE_ORIGIN=https://2512921.cn
NK_GENIOS_API_ENABLED=false
NK_GENIOS_API_KEY=
AGENT_ACCESS_CODE=
AGENT_PUBLIC_ENABLED=false
NK_GENIOS_WEB_ENABLED=false
NK_GENIOS_WEB_APP_KEY=
# Deprecated WebSDK fields are ignored; do not enable or add browser credentials.
NK_GENIOS_WEB_CONTEXT_ENABLED=false
NK_GENIOS_WEB_HIDE_SIDEBAR=true

# Cloud speech is separate from the school's chat model. Server-only credentials.
# Root origin recommended; the DashScope SDK /api/v1 base is also accepted.
# Beijing keys and Singapore keys must use their matching regional origin.
VOICE_ENABLED=false
VOICE_API_KEY=
VOICE_BASE_URL=https://dashscope.aliyuncs.com
VOICE_TIER=standard
VOICE_TIMEOUT_SECONDS=20
VOICE_MAX_CHARACTERS=300
VOICE_CACHE_TTL_SECONDS=86400
VOICE_VISITOR_REQUESTS_PER_HOUR=45
VOICE_TOTAL_REQUESTS_PER_HOUR=200
VOICE_ALLOWED_AUDIO_HOSTS=[]
VOICE_MAX_AUDIO_BYTES=8388608
VOICE_CACHE_MAX_BYTES=67108864
# Background production narration has an independent deployment switch.
# Staff must additionally obtain an independently reviewed runtime approval.
NARRATION_GENERATION_ENABLED=false
NARRATION_STAFF_REQUESTS_PER_HOUR=45
NARRATION_STAFF_REQUESTS_PER_DAY=270
NARRATION_MAX_STORAGE_BYTES=2147483648
NARRATION_UNADOPTED_DAYS=30

# Staff console: bootstrap an administrator, then enable on the exact HTTPS origin.
ADMIN_ENABLED=false
ADMIN_PUBLIC_ORIGIN=
ADMIN_SESSION_HOURS=8
ADMIN_SESSION_IDLE_MINUTES=30
# Enable only after the administrator has tested primary/backup keys and recovery.
ADMIN_MFA_ENFORCED=false
# Enable only after the fixed host backup executor, permissions and actual MFA are verified.
BACKUP_REQUESTS_ENABLED=false
BACKUP_STAFF_REQUESTS_PER_DAY=2
BACKUP_GLOBAL_REQUESTS_PER_DAY=6
BACKUP_MIN_INTERVAL_SECONDS=3600
