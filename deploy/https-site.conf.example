# Merge this location into the server's EXISTING HTTPS vhost.
# Do not replace other services' configuration or use this as a complete TLS setup.
# Also set these in the enclosing HTTPS server block after validating nginx -t:
# ssl_protocols TLSv1.2 TLSv1.3;
# server_tokens off;
# add_header Strict-Transport-Security "max-age=31536000" always;
# Do not enable includeSubDomains/preload without checking other hostnames.
location ~ ^/api/v1/admin/points/[0-9a-f-]+/experience-media$ {
    client_max_body_size 104m;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_request_buffering off;
    proxy_read_timeout 120s;
}
location ~ ^/api/v1/admin/points/[0-9a-f-]+/floor-images$ {
    client_max_body_size 32m;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_request_buffering off;
    proxy_read_timeout 120s;
}
location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_buffering off;
    proxy_read_timeout 120s;
}
