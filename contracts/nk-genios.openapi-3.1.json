    "/api/v1/campuses": {
      "get": {
        "description": "列出已启用校区，获取真实 campus_id，不要猜测校区ID。",
        "operationId": "listCampuses",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_list_Campus__"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [],
        "summary": "列出已启用校区，获取真实 campus_id，不要猜测校区ID。",
        "tags": [
          "campuses"
        ],
        "x-implementation-status": "implemented",
        "x-module": "M00"
